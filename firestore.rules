rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // MANDATORY DEFAULT-DENY CATCH-ALL
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // CORE SECURITY & VALIDATION HELPERS
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 254 && email.matches('^.+@.+\\..+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'ramkrisna97@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ===============================================================
    // ENTITY VALIDATION HELPERS
    // ===============================================================
    function isValidPlatformHubState(data) {
      let requiredFields = ['updatedAt', 'updatedByEmail', 'payloadJson'];
      let allowedFields = [
        'updatedAt',
        'updatedByEmail',
        'paymentsCount',
        'storesCount',
        'foodSuggestionsCount',
        'bookingsCount',
        'approvedPremiumEmails',
        'payloadJson'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64 &&
             data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 254 &&
             data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 950000 &&
             (!('paymentsCount' in data) || (data.paymentsCount is int && data.paymentsCount >= 0 && data.paymentsCount <= 100000)) &&
             (!('storesCount' in data) || (data.storesCount is int && data.storesCount >= 0 && data.storesCount <= 100000)) &&
             (!('foodSuggestionsCount' in data) || (data.foodSuggestionsCount is int && data.foodSuggestionsCount >= 0 && data.foodSuggestionsCount <= 100000)) &&
             (!('bookingsCount' in data) || (data.bookingsCount is int && data.bookingsCount >= 0 && data.bookingsCount <= 100000)) &&
             (!('approvedPremiumEmails' in data) || (
               data.approvedPremiumEmails is list &&
               data.approvedPremiumEmails.size() <= 500 &&
               (data.approvedPremiumEmails.size() == 0 || (data.approvedPremiumEmails[0] is string && data.approvedPremiumEmails[0].size() <= 254))
             ));
    }

    function isValidUser(data) {
      let requiredFields = ['uid', 'email', 'name', 'role'];
      let allowedFields = ['uid', 'email', 'name', 'role', 'isSubscribed', 'region', 'privacyConsent', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             isValidEmail(data.email) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.role in ['user', 'doctor', 'vendor', 'admin'] &&
             (!('isSubscribed' in data) || data.isSubscribed is bool) &&
             (!('region' in data) || data.region in ['US', 'GB', 'IN', 'AU', 'ES', 'BD']) &&
             (!('privacyConsent' in data) || data.privacyConsent is bool) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64));
    }

    function isValidClinicalAssessment(data) {
      let requiredFields = [
        'id',
        'userId',
        'userEmail',
        'currentPhase',
        'targetPhase',
        'improved',
        'improvementScore',
        'answersJson',
        'createdAt'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(requiredFields) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             isValidEmail(data.userEmail) &&
             data.currentPhase is int && data.currentPhase >= 1 && data.currentPhase <= 4 &&
             data.targetPhase is int && data.targetPhase >= 1 && data.targetPhase <= 4 &&
             data.improved is bool &&
             data.improvementScore is int && data.improvementScore >= 0 && data.improvementScore <= 100 &&
             data.answersJson is string && data.answersJson.size() >= 2 && data.answersJson.size() <= 8000 &&
             data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    // ===============================================================
    // COLLECTION RULES
    // ===============================================================
    match /platform_hub/{docId} {
      allow get: if isAuthenticated() && isValidId(docId);
      allow list: if isAuthenticated() && existing().updatedByEmail is string;
      allow create: if isVerifiedUser() &&
                    isValidId(docId) &&
                    isValidPlatformHubState(incoming());
      allow update: if isVerifiedUser() &&
                    isValidId(docId) &&
                    isValidPlatformHubState(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'updatedAt',
                      'updatedByEmail',
                      'paymentsCount',
                      'storesCount',
                      'foodSuggestionsCount',
                      'bookingsCount',
                      'approvedPremiumEmails',
                      'payloadJson'
                    ]) &&
                    (!('approvedPremiumEmails' in existing()) ||
                      incoming().approvedPremiumEmails == existing().approvedPremiumEmails ||
                      isAdmin());
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAuthenticated() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
                    isValidId(userId) &&
                    isOwner(userId) &&
                    isValidUser(incoming()) &&
                    incoming().uid == userId &&
                    ((incoming().role == 'user' && (!('isSubscribed' in incoming()) || incoming().isSubscribed == false)) || isAdmin());
      allow update: if isVerifiedUser() &&
                    isValidId(userId) &&
                    isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    ((isOwner(userId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt', 'region', 'privacyConsent']) &&
                      incoming().role == existing().role &&
                      incoming().email == existing().email) || isAdmin());
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /clinical_assessments/{assessmentId} {
      allow get: if isValidId(assessmentId) &&
                 isAuthenticated() &&
                 (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser() &&
                    isValidId(assessmentId) &&
                    isValidClinicalAssessment(incoming()) &&
                    incoming().id == assessmentId &&
                    incoming().userId == request.auth.uid;
      allow update: if isVerifiedUser() &&
                    isValidId(assessmentId) &&
                    isValidClinicalAssessment(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['improved', 'improvementScore', 'answersJson']);
      allow delete: if isValidId(assessmentId) &&
                    isAuthenticated() &&
                    (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
